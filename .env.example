# Future app configuration. Do not put real secrets in this file.

APP_PORT=4173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intelligence_ops
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=intelligence-ops-dev

# Local API auth accepts trusted OIDC-shaped claims via x-ground-control-oidc-claims.
# Production should verify OIDC tokens at the edge/API boundary before claims are trusted.
OIDC_ISSUER=
OIDC_AUDIENCE=

# AI provider keys should be supplied through a secret manager or local .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Set to "console" to print local AI observability events during development.
GROUND_CONTROL_AI_OBSERVABILITY_LOG=
